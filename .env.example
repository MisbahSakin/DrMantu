# Dr. Md. Mofizul Islam Mantu Archive Environment Configuration Example
# Copy to .env for local development

# Server Port
PORT=3000

# Administrator Credentials (No Database Required!)
# Option A: Plain password directly in Vercel environment variables (Easiest)
ADMIN_PASSWORD=YourStrongSecretArchivePassword2026!

# Option B: Bcrypt hash if preferred
# ADMIN_PASSWORD_HASH=$2a$12$eXAMpleBcryptHashPlaceholderDoNotUseInProductionXXXXXXXXXX

ADMIN_EMAIL=curator@drmofizulmantu.org
AUTH_SECRET=generate_a_random_64_character_hex_string_using_openssl_rand_hex_32

# Vercel Blob Storage Token for Image Hosting (Optional - Automatically populated in Vercel Storage tab)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxx

# Optional Database (NOT needed for database-free setup! Only if relational SQL is desired in future)
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/mantu_archive?sslmode=require
# POSTGRES_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/mantu_archive?sslmode=require
